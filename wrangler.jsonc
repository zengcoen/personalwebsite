{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coenzeng-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "coenzeng.com", "custom_domain": true },
    { "pattern": "www.coenzeng.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
